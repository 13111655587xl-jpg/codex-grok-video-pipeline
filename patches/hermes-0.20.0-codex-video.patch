+def _drop_key_recursive(value, key: str) -> int:
+    """Drop a provider-incompatible key without logging request contents."""
+    removed = 0
+    if isinstance(value, dict):
+        if key in value:
+            value.pop(key, None)
+            removed += 1
+        for child in value.values():
+            removed += _drop_key_recursive(child, key)
+    elif isinstance(value, list):
+        for child in value:
+            removed += _drop_key_recursive(child, key)
+    return removed
+
+
+def _normalize_xai_responses_body(
+    adapter: UpstreamAdapter,
+    rel_path: str,
+    body: bytes,
+) -> bytes:
+    """Remove Codex-only namespace tools that xAI Responses rejects."""
+    if adapter.name != "xai" or rel_path != "/responses" or not body:
+        return body
+    try:
+        payload = json.loads(body)
+    except (TypeError, ValueError):
+        return body
+    if not isinstance(payload, dict) or not isinstance(payload.get("tools"), list):
+        return body
+    removed_external_web_access = _drop_key_recursive(payload, "external_web_access")
+    tools = payload["tools"]
+    supported_tools = [
+        tool
+        for tool in tools
+        if not (isinstance(tool, dict) and tool.get("type") == "namespace")
+    ]
+    removed = len(tools) - len(supported_tools)
+    if not removed and not removed_external_web_access:
+        return body
+    payload["tools"] = supported_tools
+    logger.info("proxy: removed %d unsupported Codex namespace tool(s)", removed)
+    return json.dumps(payload, separators=(",", ":")).encode("utf-8")
+
+
